---
// One page per Field Notes issue: /inthefield/001, /inthefield/002, ...
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/400-italic.css';
import '@fontsource/courier-prime/700.css';
import '../../styles/field-notes.css';
import footerArt from '../../assets/field-notes/footer.jpg';
import footerArtMobile from '../../assets/field-notes/footer-mobile.jpg';

export async function getStaticPaths() {
  const issues = await getCollection('issues', ({ data }) => !data.draft);
  return issues.map((issue) => ({ params: { number: issue.data.number }, props: { issue } }));
}

const { issue } = Astro.props;
const { Content } = await render(issue);
const { number, date, location, description, cover, coverMobile, coverAlt, dateImage } = issue.data;

// Dateline as typed: 10-21-26
const pad = (n: number) => String(n).padStart(2, '0');
const dateline = `${pad(date.getUTCMonth() + 1)}-${pad(date.getUTCDate())}-${String(date.getUTCFullYear()).slice(-2)}`;
const coverRatio = (cover.height / cover.width).toFixed(4);
// Phones get their own art (tall cover, stacked footer) via <picture>
const PHONE = '(max-width: 640px)';
const srcset = async (src: ImageMetadata, widths: number[]) =>
  (await Promise.all(widths.map(async (w) => `${(await getImage({ src, width: w, format: 'webp' })).src} ${w}w`))).join(', ');
const coverMobileSet = coverMobile ? await srcset(coverMobile, [600, 900, 1300]) : null;
const footerMobileSet = await srcset(footerArtMobile, [600, 900, 1300]);
const social = await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
---
<Base title={`Field Notes No. ${number}`} description={description} bodyClass="field-notes" image={social.src} type="article" header={false} footer={false}>
  <article class="fn" style={`--fn-cover-ratio:${coverRatio}`}>
    <!-- The cover holds in place while the letter slides up over it -->
    <div class="fn-cover">
      <picture>
      {coverMobileSet && <source media={PHONE} srcset={coverMobileSet} sizes="100vw" width={coverMobile!.width} height={coverMobile!.height} />}
      <Image
        src={cover}
        alt={coverAlt}
        widths={[800, 1400, 2000, 2800]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="fn-cover__img"
      />
      </picture>
    </div>

    <!-- Folder tab on the top edge of the sheet, with the date written on it.
         It lives outside the sheet so the sheet's side clipping (for photos that
         bleed off the page) can never clip it — Safari clips both directions. -->
    <div class="fn-tabrow">
        <div class="fn-tab">
          <time datetime={date.toISOString().slice(0, 10)}>
            {dateImage
              ? <Image src={dateImage} alt={dateline} widths={[200, 400]} sizes="9rem" class="fn-tab__date" />
              : dateline}
          </time>
        </div>
    </div>

    <div class="fn-sheet">
      <div class="fn-dateline">
        <span>{location}</span>
      </div>

      <div class="fn-body">
        <h1 class="fn-title">Field Notes No. {number}</h1>
        <Content />
      </div>

    </div>

    <!-- Footer art sits pinned behind the letter; the sheet's rounded bottom
       scrolls up off it like the end of a folder. The button area is a real link. -->
    <div class="fn-end">
    <aside class="fn-subscribe" aria-labelledby="fn-subscribe-title">
      <h2 id="fn-subscribe-title" class="fn-visually-hidden">Get the next letter</h2>
      <picture>
      <source media={PHONE} srcset={footerMobileSet} sizes="100vw" width={footerArtMobile.width} height={footerArtMobile.height} />
      <Image
        src={footerArt}
        alt="Get the next letter. Field Notes arrives once a month: unreleased songs, stories from the studio, and whatever I’m working through. Already subscribed? Reply to any letter and it comes straight to me."
        widths={[800, 1400, 2000, 3000]}
        sizes="100vw"
        class="fn-subscribe__art"
      />
      </picture>
      <a class="fn-subscribe__button" href="https://laylo.com/jonnystanback" target="_blank" rel="noopener">Subscribe to Field Notes</a>
    </aside>
    </div>
  </article>
</Base>
