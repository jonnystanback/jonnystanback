---
// Field Notes: each issue is a folder. Newest first.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Paper from '../../layouts/Paper.astro';
import folder from '../../assets/pages/folder.png';

const issues = (await getCollection('issues', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Paper title="Field Notes" description="Field Notes: a monthly letter from Jonny Stanback with unreleased songs, stories and works in progress.">
  {issues.map((issue) => (
    <a class="pp-folder" href={`/inthefield/${issue.data.number}`}>
      <Image src={folder} alt={`Field Notes No. ${issue.data.number}`} widths={[500, 900]} sizes="26rem" />
    </a>
  ))}
</Paper>
