---
// Homepage: a prairie photo with the running horse and the name over it,
// then the menu page slides up over it like the next sheet in the folder.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import hero from '../assets/home/hero2.jpg';
import field from '../assets/home/field.jpg';
import '../styles/home.css';

const menu = [
  { label: 'Music', href: '/music' },
  { label: 'Tour', href: '/tour' },
  { label: 'Merch', href: '/merch' },
  { label: 'Field Notes', href: '/inthefield' },
  { label: 'About', href: '/about' },
];
---
<Base bodyClass="hp" header={false} footer={false}>
  <main class="hp-wrap">
    <!-- 1. Intro: prairie photo, name, running horse. Holds still while the menu page covers it. -->
    <section class="hp-intro" aria-label="Jonny Stanback">
      <Image src={field} alt="" widths={[800, 1400, 2000, 2800, 3840]} sizes="100vw" loading="eager" fetchpriority="high" class="hp-intro__video" />
      <h1 class="hp-name">Jonny Stanback</h1>
      <picture class="hp-horse">
        <source srcset="/home/horse-still.webp" media="(prefers-reduced-motion: reduce)" />
        <img src="/home/horse.webp" alt="" width="1000" height="735" />
      </picture>
      <img class="hp-intro__ts" src="/home/ts.png" alt="" />
      <p class="hp-intro__tag">The official website of<br />the musician Jonny<br />Stanback.</p>
    </section>

    <!-- 2. Menu page -->
    <section class="hp-menu" id="menu">
      <Image src={hero} alt="Jonny sitting on a couch in a wood-paneled room." widths={[800, 1400, 2000, 3000]} sizes="100vw" class="hp-menu__bg" />
      <nav class="hp-nav" aria-label="Main">
        <ul>
          {menu.map((m) => <li><a href={m.href}>{m.label}</a></li>)}
        </ul>
      </nav>
      <img class="hp-mark hp-mark--horse" src="/home/mark-horse.png" alt="" />
      <img class="hp-mark hp-mark--ts" src="/home/ts.png" alt="" />
    </section>
  </main>
</Base>
