---
import Paper from '../layouts/Paper.astro';

// Add shows here and they'll list automatically. Leave empty for the "no dates" note.
// Example: { date: 'Mar 15, 2027', venue: 'The Roxy Theatre', city: 'Los Angeles, CA', tickets: 'https://...' }
const shows: { date: string; venue: string; city: string; tickets: string }[] = [];
---
<Paper title="Tour">
  {shows.length === 0 ? (
    <p class="pp-tour-empty pp-type">No dates yet<br />Check back soon<br />for 2027 shows</p>
  ) : (
    <ul class="pp-tour pp-col">
      {shows.map((s) => (
        <li class="pp-type">
          <span>{s.date}</span>
          <span>{s.venue}<br /><small>{s.city}</small></span>
          <a href={s.tickets} target="_blank" rel="noopener">Tickets</a>
        </li>
      ))}
    </ul>
  )}
</Paper>
