---
// Voice memo titles + dates, typed into the letter as a short list.
interface Memo { title: string; date: string; }
interface Props { memos: Memo[]; }
const { memos } = Astro.props;
---
<ul class="fn-memos">
  {memos.map((m) => <li>“{m.title}” <span class="fn-memos__date">– {m.date}</span></li>)}
</ul>
