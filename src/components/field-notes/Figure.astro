---
// Photos inside an issue.
//  layout="wide":       breaks the text, spanning the column and the margin
//  layout="break-left": breaks the text, bleeding off the left edge; caption sits in the margin
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  layout?: 'wide' | 'break-left';
}
const { src, alt, caption, layout = 'wide' } = Astro.props;
---
{layout === 'break-left' ? (
  <figure class="fn-break-left">
    <Image src={src} alt={alt} widths={[640, 1000, 1400]} sizes="(min-width: 1100px) 55vw, 100vw" />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
) : (
  <figure class="fn-wide">
    <Image src={src} alt={alt} widths={[640, 1100, 1600, 2100]} sizes="(min-width: 1100px) 992px, 100vw" />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
)}
