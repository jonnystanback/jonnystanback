---
// Photos inside an issue.
//  layout="spread": photo bleeds off the left edge, the text that follows sits beside it (desktop)
//  layout="wide":   photo spans wider than the text column
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  layout?: 'spread' | 'wide';
}
const { src, alt, caption, layout = 'wide' } = Astro.props;
---
{layout === 'spread' ? (
  <section class="fn-spread">
    <figure class="fn-spread__figure">
      <Image src={src} alt={alt} widths={[640, 1000, 1400]} sizes="(min-width: 1100px) 46vw, 100vw" />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
    <div class="fn-spread__text"><slot /></div>
  </section>
) : (
  <figure class="fn-wide">
    <Image src={src} alt={alt} widths={[640, 1100, 1600, 2100]} sizes="(min-width: 1100px) 1040px, 100vw" />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
)}
