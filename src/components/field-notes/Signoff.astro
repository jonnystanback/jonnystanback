---
import { Image } from 'astro:assets';
import signature from '../../assets/field-notes/001/signature.png';
interface Props { line?: string; }
const { line = 'See you next month,' } = Astro.props;
---
<div class="fn-signoff">
  <p>{line}</p>
  <!-- served at 2-4x its display width so it stays sharp on high-res screens -->
  <Image src={signature} alt="Jonny" widths={[380, 570, 760]} sizes="190px" format="png" class="fn-signoff__sig" />
</div>
