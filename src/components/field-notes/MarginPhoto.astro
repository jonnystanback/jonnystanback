---
// A small photo pinned in the right margin beside the text (desktop).
// On phones it sits inline, set in from the left.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata; alt: string; caption?: string; }
const { src, alt, caption } = Astro.props;
---
<figure class="fn-margin-photo">
  <Image src={src} alt={alt} widths={[400, 640, 900]} sizes="(min-width: 1100px) 320px, 60vw" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
