---
// A handwritten note or doodle (transparent PNG) set beside the writing.
// kind="note": a line of handwriting that hangs out into the left or right margin,
//              or side="center": set inline in the column, between paragraphs.
// kind="doodle": a small drawing pinned in the left or right margin.
//              size: its width on wide screens (default 6rem).
//              offset: how far out from the column it sits; a negative value
//              pulls it in over the column, beside a short line of text.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  side?: 'left' | 'right' | 'center';
  kind?: 'note' | 'doodle';
  size?: string;
  offset?: string;
}
const { src, alt, side = 'right', kind = 'note', size, offset } = Astro.props;
const style = [size && `--fn-doodle-w:${size}`, offset && `--fn-doodle-x:${offset}`].filter(Boolean).join(';') || undefined;
const cls = kind === 'doodle' ? `fn-doodle fn-doodle--${side}` : `fn-note fn-note--${side}`;
---
<figure class={cls} style={style}>
  <Image src={src} alt={alt} widths={kind === 'doodle' ? [200, 400] : [500, 800, 1200]} sizes={kind === 'doodle' ? '10rem' : '(min-width: 640px) 30rem, 92vw'} />
</figure>
