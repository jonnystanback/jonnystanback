---
const links = [
  { href: '/music', label: 'Music' },
  { href: '/tour', label: 'Tour' },
  { href: '/merch', label: 'Merch' },
  { href: '/inthefield', label: 'Field Notes' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
---
<div class="pp-nav" role="banner">
  <a class="pp-nav__home" href="/" aria-label="Home"><img src="/home/mark-horse.png" alt="" width="60" height="60" /></a>
  <nav class="pp-nav__links" aria-label="Main">
    <ul>
      {links.map((l) => (
        <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</div>
