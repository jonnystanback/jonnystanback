{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tour.html",
      "destination": "/tour",
      "permanent": true
    },
    {
      "source": "/music.html",
      "destination": "/music",
      "permanent": true
    },
    {
      "source": "/merch.html",
      "destination": "/merch",
      "permanent": true
    }
  ]
}
